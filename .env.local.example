# Copy this to .env.local (never commit the real .env.local).
#
# This app talks to the crowdfunding Anchor program from
# ../solana-rust/02-crowdfunding-spl, already deployed on devnet.

# devnet's public RPC rate-limits aggressively (hit this directly while
# deploying the program) - swap in a private RPC (Helius, Ankr, Alchemy,
# QuickNode, ...) here if reads/writes start failing with 429s.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# The deployed crowdfunding program id (devnet).
NEXT_PUBLIC_PROGRAM_ID=6hafcYNa34it4syjPPy8yuQW5LfCmcxhm3D78h2qBA5r

# SPL token campaigns are denominated in. Defaults to the token minted in
# ../solana-rust/01-spl-token-deploy - swap for devnet USDC or any other
# mint you want to test with.
NEXT_PUBLIC_TOKEN_MINT=Chtf3dLtuCaBP8mNcC5FcSwA1fvBTZbnPY4xbsuriHMb
NEXT_PUBLIC_TOKEN_DECIMALS=6

# Used only to build Solana Explorer links (address/tx). Must be one of:
# devnet | testnet | mainnet-beta
NEXT_PUBLIC_EXPLORER_CLUSTER=devnet
